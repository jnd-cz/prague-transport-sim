# One style for every editor and agent (issue #5). Formatting tools read the same settings:
# Python: ruff.toml; JS: no formatter until the Node/Deno step (M5), keep the surrounding style.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 120

[*.py]
indent_size = 4

[*.rs]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
