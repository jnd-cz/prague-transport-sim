# the pinned source snapshot (OSM, GTFS, survey, terrain, Geoportál) — ~2 GB, DATA.md
raw/

# Python / OS / editor noise
__pycache__/
*.pyc
.DS_Store
Thumbs.db
.vscode/
.idea/

# deploy package (tools/make_dist.py)
dist/

# lint reports (tools/lint.js); the baseline in reports/baseline/ is committed
reports/*.json

# tools/snapshot.py download scratch
.snap-*/

# game data: in the data store (DATA.md), only the manifest and the hand-made truth in git
data/*
!data/truth.json
!data/MANIFEST.json

# headless check results (tools/headless.py) and runs' logs and folders kept beside them
reports/headless/
reports/headless-*/
reports/*.log

# comparison evidence (tools/shot.py, tools/datadiff.py)
reports/shots/
reports/diffs/

# rebuild logs (tools/rebuild.py)
reports/rebuild/

# web host login for tools/deploy.py (host, user, folder; never the password)
deploy.local.json

# review verdicts (tools/serve.py, tools/deploy.py --pull-reviews)
reports/reviews/

# tools/autodeploy.py log and state
reports/autodeploy.*
