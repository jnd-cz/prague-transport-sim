# download caches (OSM, GTFS, terrain, Geoportál) — ~420 MB, rebuilt by the tools
raw/

# Python / OS / editor noise
__pycache__/
*.pyc
.DS_Store
Thumbs.db
.vscode/
.idea/

# deploy package (tools/make_dist.py)
dist/

# lint reports (tools/lint.js); the baseline in reports/baseline/ is committed
reports/*.json

# tools/snapshot.py download scratch
.snap-*/

# game data: in the data store (DATA.md), only the manifest and the hand-made truth in git
data/*
!data/truth.json
!data/MANIFEST.json
