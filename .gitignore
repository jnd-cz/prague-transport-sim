# the pinned source snapshot (OSM, GTFS, survey, terrain, Geoportál) — ~4.3 GB, DATA.md
raw/

# Python / OS / editor noise
__pycache__/
*.pyc
.DS_Store
Thumbs.db
.vscode/
.idea/

# deploy package (tools/make_dist.py)
dist/

# tools/snapshot.py download scratch
.snap-*/

# game data: in the data store (DATA.md), only the manifest and the hand-made truth in git
data/*
!data/truth.json
!data/MANIFEST.json

# web host login for tools/deploy.py (host, user, folder; never the password)
deploy.local.json

# reports/: the tools' output and a session's scratch, none of it in git (lint reports, headless results and logs,
# the baselines' local copy, shots, diffs, rebuild logs, review verdicts, autodeploy's log and state, the city
# terrain's report). Only the review findings files are in git (reports/review/*.json and their notes), without
# the review directory's index, which tools/deploy.py builds at each deploy (#288)
reports/*
!reports/review/
reports/review/*
!reports/review/*.json
!reports/review/*.md
reports/review/index.json
